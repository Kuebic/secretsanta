{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretsanta",
  // Same Cloudflare account as the sibling repos. Deploys use `wrangler login` (OAuth); there is no API token.
  "account_id": "5e7c03d562a80de198b3edeb8212639c",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Vite build output (`npm run build`).
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown page paths get index.html so react-router handles /pairing, /o/..., /p/...
    "not_found_handling": "single-page-application",
    // /api/* always reaches the Worker, never the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "EVENTS",
      // Created 2026-11-09 on the personal account (ticket 14). `wrangler dev` and tests use local KV.
      "id": "cf65a224cd7749559205f18325a2c8b9"
    }
  ]
}
